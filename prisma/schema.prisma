generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model EmployeeTerritories {
  id          String     @id @default(uuid())
  employeeId  String
  territoryId Int
  assignedAt  DateTime

  employee   Employees   @relation(fields: [employeeId], references: [employeeId])
  territory  Territories @relation(fields: [territoryId], references: [territoryId])

  @@map("employee_territories")
}

model Employees {
  employeeId String         @id @default(uuid())
 //userId     String
  fullName   String
  designation String
  email      String         @unique
  status     EmployeeStatus
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  //user                Users?                @relation(fields: [userId], references: [userId])
  employeeTerritories EmployeeTerritories[]
}

model Users {
  userId       String    @id @default(uuid())
 roleId       String
 username     String    @unique
  email        String    @unique
  passwordHash String
 createdAt    DateTime  @default(now())
 updatedAt    DateTime  @updatedAt

 //role      Roles     @relation(fields: [roleId], references: [roleId])
 //employees Employees[]
}

model Roles {
  roleId    String   @id @default(uuid())
  roleName  String   @unique
  createdAt DateTime @default(now())

  //users Users[]
}

model Territories {
  territoryId   Int      @id @default(autoincrement())
  territoryName String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employeeTerritories EmployeeTerritories[]
  complaints          Complaints[]
}

model Complaints {
  complaintId               String    @id @default(uuid())
  contactPersonName         String
  mailId                    String
  mobileNumber              String
  companyName               String
  territoryId               Int
  gearboxSerialNumber       String
  dateOfCommissioning       DateTime
  complaintDate             DateTime  // <-- Added date field
  applicationDetails        String
  natureOfComplaintWithPhotos String
  inputMotorDetailsKw       Decimal
  inputOutputConnectionDetails String
  oilLevelDetails           String
  gradeOfOilUsed            String
  conditionOfOil            String
  conditionOfBreather       String
  sedimentInOilBottom       String
  alignmentInputOutput      String
  runningHoursPerDay        Int
  startStopPerDay           Int
  dismantledBeforeFailure   String
  ambientConditions         String
  loadSpectrum              String
  forcedLubricationPhotos   String
  conditionOfOtherParts     String
  lubricationCheckDetails   String
  inputSpeedDetails         String
  failureHistoryDetails     String
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  territory Territories @relation(fields: [territoryId], references: [territoryId])

  @@map("complaints")
}
